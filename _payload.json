[{"data":1,"prerenderedAt":289},["ShallowReactive",2],{"content-query-o2eytCKEPH":3,"content-query-bn1FvRuP84":101},{"_path":4,"_dir":5,"_draft":6,"_partial":6,"_locale":5,"title":7,"description":8,"body":9,"_type":95,"_id":96,"_source":97,"_file":98,"_stem":99,"_extension":100},"/presentation","",false,"Presentation","Notez que la cueillette 2026 ouvrira le jeudi 3 septembre à 9h !",{"type":10,"children":11,"toc":89},"root",[12,23,30,67,73,78,84],{"type":13,"tag":14,"props":15,"children":16},"element","p",{},[17],{"type":13,"tag":18,"props":19,"children":20},"strong",{},[21],{"type":22,"value":8},"text",{"type":13,"tag":24,"props":25,"children":27},"h2",{"id":26},"que-proposons-nous",[28],{"type":22,"value":29},"Que proposons nous ?",{"type":13,"tag":14,"props":31,"children":32},{},[33,35,40,42,47,48,53,54,59,60,65],{"type":22,"value":34},"Venez respirer l'air des hauteurs de Plauzat, sur les pentes du Puy de Saint-Sandoux, entre Clermont-Ferrand et Issoire. Choisissez et cueillez vos pommes sur l'arbre. Nous produisons les variétés suivantes : ",{"type":13,"tag":18,"props":36,"children":37},{},[38],{"type":22,"value":39},"Golden",{"type":22,"value":41},", ",{"type":13,"tag":18,"props":43,"children":44},{},[45],{"type":22,"value":46},"Canada",{"type":22,"value":41},{"type":13,"tag":18,"props":49,"children":50},{},[51],{"type":22,"value":52},"Starking",{"type":22,"value":41},{"type":13,"tag":18,"props":55,"children":56},{},[57],{"type":22,"value":58},"Comte",{"type":22,"value":41},{"type":13,"tag":18,"props":61,"children":62},{},[63],{"type":22,"value":64},"Royal Gala",{"type":22,"value":66},".",{"type":13,"tag":24,"props":68,"children":70},{"id":69},"comment-faire",[71],{"type":22,"value":72},"Comment faire ?",{"type":13,"tag":14,"props":74,"children":75},{},[76],{"type":22,"value":77},"Présentez vous au Domaine de Beaune, accédez au verger et cueillez les pommes que vous souhaitez et repassez au Domaine pour le pesage. Les vergers sont aisément accessibles à pied ou en voiture.",{"type":13,"tag":24,"props":79,"children":81},{"id":80},"qui-sommes-nous",[82],{"type":22,"value":83},"Qui sommes nous ?",{"type":13,"tag":14,"props":85,"children":86},{},[87],{"type":22,"value":88},"Nous sommes une exploitation agricole familiale et produisons entre autres des pommes sur 4 hectares. Grâce à l'eau du ciel, le soleil, le sol riche et volcanique des puys et un usage minimaliste et raisonné de traitements, les fruits profitent du terroir exceptionnel des coteaux d'Auvergne pour mûrir à leur rythme.",{"title":5,"searchDepth":90,"depth":90,"links":91},2,[92,93,94],{"id":26,"depth":90,"text":29},{"id":69,"depth":90,"text":72},{"id":80,"depth":90,"text":83},"markdown","content:presentation.md","content","presentation.md","presentation","md",[102,139,237],{"_path":103,"_dir":104,"_draft":6,"_partial":6,"_locale":5,"title":105,"description":106,"date":107,"image":108,"excerpt":109,"body":123,"_type":95,"_id":136,"_source":97,"_file":137,"_stem":138,"_extension":100},"/articles/2026-09-21-fermeture-cueillette-2026","articles","Braderie pommes à compote","La cueillette des pommes est maintenant terminée !\nA l'année prochaine !","2026-09-21T00:00:00.000Z","/assets/images/royal-gala.jpg",{"type":10,"children":110},[111],{"type":13,"tag":14,"props":112,"children":113},{},[114,116,121],{"type":22,"value":115},"La cueillette des pommes est maintenant ",{"type":13,"tag":18,"props":117,"children":118},{},[119],{"type":22,"value":120},"terminée",{"type":22,"value":122}," !\nA l'année prochaine !",{"type":10,"children":124,"toc":134},[125],{"type":13,"tag":14,"props":126,"children":127},{},[128,129,133],{"type":22,"value":115},{"type":13,"tag":18,"props":130,"children":131},{},[132],{"type":22,"value":120},{"type":22,"value":122},{"title":5,"searchDepth":90,"depth":90,"links":135},[],"content:articles:2026-09-21-fermeture-cueillette-2026.md","articles/2026-09-21-fermeture-cueillette-2026.md","articles/2026-09-21-fermeture-cueillette-2026",{"_path":140,"_dir":104,"_draft":6,"_partial":6,"_locale":5,"title":141,"description":142,"date":143,"image":144,"excerpt":145,"body":158,"_type":95,"_id":234,"_source":97,"_file":235,"_stem":236,"_extension":100},"/articles/2026-09-03-ouverture-cueillette-2025","Ouverture de la cueillette 2026","La cueillette de pommes 2026 commencera le jeudi 3 septembre à 9h.","2026-09-03T00:00:00.000Z","/assets/images/trois-golden.jpg",{"type":10,"children":146},[147],{"type":13,"tag":14,"props":148,"children":149},{},[150,152,157],{"type":22,"value":151},"La cueillette de pommes 2026 commencera le ",{"type":13,"tag":18,"props":153,"children":154},{},[155],{"type":22,"value":156},"jeudi 3 septembre à 9h",{"type":22,"value":66},{"type":10,"children":159,"toc":232},[160,169,174,186,204,216,221],{"type":13,"tag":14,"props":161,"children":162},{},[163,164,168],{"type":22,"value":151},{"type":13,"tag":18,"props":165,"children":166},{},[167],{"type":22,"value":156},{"type":22,"value":66},{"type":13,"tag":14,"props":170,"children":171},{},[172],{"type":22,"value":173},"Vous pourrez cueillir de la Golden, Canada grise, Canada blanche, Royal Gala, Starking, Jubilé et Comte.",{"type":13,"tag":14,"props":175,"children":176},{},[177,179,184],{"type":22,"value":178},"Munissez-vous de vos caisses, cageots et sacs, nous ne pourrons pas vous en fournir.\nLe prix est le même que l'année dernière : ",{"type":13,"tag":18,"props":180,"children":181},{},[182],{"type":22,"value":183},"1€50 le kilo",{"type":22,"value":185},", toutes variétés confondues.",{"type":13,"tag":14,"props":187,"children":188},{},[189,191,196,198,203],{"type":22,"value":190},"Comme l'an dernier, nous vous proposerons des ",{"type":13,"tag":18,"props":192,"children":193},{},[194],{"type":22,"value":195},"lentilles vertes",{"type":22,"value":197}," cultivées sur les terres du domaine de Beaune au prix de ",{"type":13,"tag":18,"props":199,"children":200},{},[201],{"type":22,"value":202},"8€ par kilo",{"type":22,"value":66},{"type":13,"tag":14,"props":205,"children":206},{},[207,209,214],{"type":22,"value":208},"Et puis toujours notre ",{"type":13,"tag":18,"props":210,"children":211},{},[212],{"type":22,"value":213},"jus de pommes, 4€ le litre",{"type":22,"value":215},", pressé avec les fruits de nos vergers.",{"type":13,"tag":14,"props":217,"children":218},{},[219],{"type":22,"value":220},"À très bientôt au Domaine de Beaune, nous vous accueillerons avec sourire et bonne humeur.",{"type":13,"tag":14,"props":222,"children":223},{},[224,230],{"type":13,"tag":225,"props":226,"children":227},"em",{},[228],{"type":22,"value":229},"Horaires d'ouverture :",{"type":22,"value":231}," tous les jours de 9H à 18H",{"title":5,"searchDepth":90,"depth":90,"links":233},[],"content:articles:2026-09-03-ouverture-cueillette-2025.md","articles/2026-09-03-ouverture-cueillette-2025.md","articles/2026-09-03-ouverture-cueillette-2025",{"_path":238,"_dir":104,"_draft":6,"_partial":6,"_locale":5,"title":239,"description":240,"date":241,"image":242,"excerpt":243,"body":249,"_type":95,"_id":286,"_source":97,"_file":287,"_stem":288,"_extension":100},"/articles/2024-02-11-haies","Plantation de haies","Soucieux de préserver le terroir, le Domaine de Beaune s'est engagé dans la plantation de haies.","2024-02-11T00:00:00.000Z","/assets/images/plantation_haie.jpg",{"type":10,"children":244},[245],{"type":13,"tag":14,"props":246,"children":247},{},[248],{"type":22,"value":240},{"type":10,"children":250,"toc":284},[251,255,260],{"type":13,"tag":14,"props":252,"children":253},{},[254],{"type":22,"value":240},{"type":13,"tag":14,"props":256,"children":257},{},[258],{"type":22,"value":259},"Afin de limiter l'érosion des sols et favoriser la biodiversité nous avons planté cette année 135 mètres de haies le long d'une parcelle.",{"type":13,"tag":14,"props":261,"children":262},{},[263,265,274,276,283],{"type":22,"value":264},"Pour ce faire, nous avons bénéficié du soutien du ",{"type":13,"tag":266,"props":267,"children":271},"a",{"href":268,"rel":269},"https://www.puy-de-dome.fr/conseil-departemental-du-puy-de-dome.html",[270],"nofollow",[272],{"type":22,"value":273},"conseil général du Puy-de-Dôme",{"type":22,"value":275},",\nainsi que de la ",{"type":13,"tag":266,"props":277,"children":280},{"href":278,"rel":279},"https://missionhaies.wixsite.com/mission-haies",[270],[281],{"type":22,"value":282},"mission haies",{"type":22,"value":66},{"title":5,"searchDepth":90,"depth":90,"links":285},[],"content:articles:2024-02-11-haies.md","articles/2024-02-11-haies.md","articles/2024-02-11-haies",1789977120917]